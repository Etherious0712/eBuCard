<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core NFC reading of the NDEF card emitted by Android senders. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- Universal links for https://<card domain>/c/<slug> are added here
	     (com.apple.developer.associated-domains) once the domain is chosen. -->
</dict>
</plist>
