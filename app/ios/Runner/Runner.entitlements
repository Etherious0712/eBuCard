<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core NFC reading of the NDEF card emitted by Android senders. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- Universal links for https://<server>/c/<slug>: once the domain and
	     Apple Team ID exist, add com.apple.developer.associated-domains with
	     applinks:<server host> here (app/README.md). The app already handles
	     the /c/<slug> route. -->
</dict>
</plist>
